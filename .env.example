# SQLite file (Prisma). For Docker, mount a volume at /data.
DATABASE_URL="file:./prisma/dev.db"

# Where downloaded audio is cached
DOWNLOAD_DIR="./downloads"

# Concurrent downloads (spec: < 10 simultaneous). Default 3.
DOWNLOAD_CONCURRENCY=3

# Admin console password (simple shared secret for internal use)
ADMIN_PASSWORD="changeme"

# App port
PORT=3000
